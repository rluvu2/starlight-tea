# ─────────────────────────────────────────────────────────────
#  별빛 찻집 · 배포 설정  (공개되어도 괜찮은 값만 적어요)
# ─────────────────────────────────────────────────────────────

# 사이트 경로. 지금은 https://rluvu2.github.io/starlight-tea/ 에 배포하므로 /starlight-tea/ 입니다.
# 커스텀 도메인(https://내도메인/)을 연결하면 / 로 바꾸고 아래 CUSTOM_DOMAIN 을 적어 주세요.
BASE_PATH=/starlight-tea/

# 커스텀 도메인 (예: starlight-teahouse.com). 적어 두면 빌드할 때 CNAME 파일을 만들어요.
CUSTOM_DOMAIN=

# Google AdSense 게시자 ID (예: ca-pub-1234567890123456)
# 비워 두면 광고 스크립트가 빠지고, '팽주의 조언'이 광고 없이 바로 열려요.
VITE_ADSENSE_CLIENT=
